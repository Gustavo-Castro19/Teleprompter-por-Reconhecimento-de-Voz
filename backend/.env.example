FLASK_ENV=production
SECRET_KEY=your-super-secret-key-change-in-production

HOST=0.0.0.0
PORT=8000

VOSK_MODEL_PATH=/app/models/vosk-model-pt

AUDIO_DEVICE_INDEX=
AUDIO_CHUNK_SIZE=4096
AUDIO_FORMAT=16
AUDIO_CHANNELS=1
AUDIO_RATE=16000

SCRIPT_PATH=roteiros/roteiro_demo_bddf.json

PALAVRAS_POR_MINUTO_BASE=150
SIMILARIDADE_MINIMA=0.6
COBERTURA_MINIMA=0.4
RELEVANCIA_MINIMA=0.3
INTERVALO_AVANCO=0.8
SCORE_MINIMO_ANDAMENTO_VOZ=0.35
HABILITAR_IMPROVISO=true
MIN_PALAVRAS_IMPROVISO=3

VELOCIDADE_MINIMA_ROLAGEM=0.05
VELOCIDADE_MAXIMA_ROLAGEM=3.0

TP_MAX_WIDTH_VW=90
TP_MAX_HEIGHT_VH=60
TP_ASPECT_RATIO=4/3

# Comma-separated list of allowed origins (no wildcards in production)
CORS_ALLOWED_ORIGINS=http://0.0.0.0:8000,http://localhost:8000,http://127.0.0.1:8000
